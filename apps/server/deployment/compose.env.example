# Copy outside the repository as the Compose interpolation source for the
# origin and authorized-download files and mounts. These are Compose
# interpolation values, not service environment variables; `env_file` cannot
# provide Compose volume sources.
ASTRO_ORIGIN_IMAGE=ghcr.io/chicks/astro-console:REPLACE_WITH_PINNED_RELEASE
ASTRO_ORIGIN_ENV_FILE=/ABSOLUTE/HOST/PATH/config.env
ASTRO_DOWNLOAD_GRANT_ENV_FILE=/ABSOLUTE/HOST/PATH/download-grant.env
ASTRO_DOWNLOAD_GRANT_SHARED_SECRET_HOST_PATH=/ABSOLUTE/HOST/PATH/download-grant-shared-secret
ASTRO_MEMBERSHIP_BOOTSTRAP_HOST_PATH=/ABSOLUTE/HOST/PATH/membership-bootstrap.json
ASTRO_PLATE_SOLVE_INDEXES_HOST_PATH=/ABSOLUTE/HOST/PATH/astrometry-indexes
R2_DOWNLOAD_CREDENTIALS_HOST_PATH=/ABSOLUTE/HOST/PATH/r2-download-credentials.json
# Keep both listeners loopback-only on the host. Tunnel uses the remote port;
# the local owner uses the separate owner port.
ASTRO_REMOTE_HOST_PORT=18080
ASTRO_LOCAL_OWNER_HOST_PORT=18081
ASTRO_REMOTE_DESKTOP_HOST_PORT=18082
