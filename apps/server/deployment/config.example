# Copy outside the repository and set only non-secret release configuration.
ASTRO_SERVER_DB=/var/lib/astro-console/state.sqlite
ASTRO_SERVER_PORT=8080
ASTRO_LOCAL_OWNER_PORT=8081
ASTRO_REMOTE_DESKTOP_PORT=8082
# Compose uses 0.0.0.0 only inside its private network; host publishes no port.
ASTRO_SERVER_BIND=0.0.0.0
ASTRO_RELEASE=REPLACE_WITH_RELEASE
# The release image packages the version-matched web build here. Override only
# for an intentionally different mounted web bundle.
ASTRO_WEB_DIST=../web/dist
ASTRO_PREVIEW_ROOT=/var/lib/astro-console/previews
# Local Astrometry.net solve worker. Compose mounts this index directory read-only.
ASTRO_PLATE_SOLVE_EXECUTABLE=/usr/bin/solve-field
ASTRO_PLATE_SOLVE_INDEXES_ROOT=/var/lib/astro-console/astrometry-indexes
ASTRO_PLATE_SOLVE_TIMEOUT_MS=90000
ASTRO_PLATE_SOLVE_SOLVER_VERSION=0.93
ASTRO_PLATE_SOLVE_SCALE_LOW_DEG=20
ASTRO_PLATE_SOLVE_SCALE_HIGH_DEG=30
ASTRO_PLATE_SOLVE_SEARCH_RADIUS_DEG=15
# Reviewed configured-rig identity and site. A camera and telescope UniqueID
# plus all three site values activate the hold-only configured Acquire path.
ASTRO_PREFLIGHT_PROVIDER=alpaca
ASTRO_PREFLIGHT_ALPACA_RIG_ID=REPLACE_WITH_RIG_ID
ASTRO_PREFLIGHT_ALPACA_HOST=REPLACE_WITH_ALPACA_HOST
ASTRO_PREFLIGHT_ALPACA_PORT=11111
ASTRO_PREFLIGHT_ALPACA_CAMERA_DEVICE_NUMBER=1
ASTRO_PREFLIGHT_ALPACA_CAMERA_UNIQUE_ID=REPLACE_WITH_CAMERA_UNIQUE_ID
ASTRO_PREFLIGHT_ALPACA_TELESCOPE_DEVICE_NUMBER=0
ASTRO_PREFLIGHT_ALPACA_TELESCOPE_UNIQUE_ID=REPLACE_WITH_TELESCOPE_UNIQUE_ID
ASTRO_PREFLIGHT_RIG_LATITUDE_DEGREES=REPLACE_WITH_LATITUDE
ASTRO_PREFLIGHT_RIG_LONGITUDE_DEGREES=REPLACE_WITH_LONGITUDE
ASTRO_PREFLIGHT_RIG_ELEVATION_METERS=REPLACE_WITH_ELEVATION
# Development fixture admission is loopback-only. Production requires the
# following non-secret identifiers and host-managed file paths.
ASTRO_ADMISSION_MODE=production
CF_ACCESS_ISSUER=https://REPLACE.cloudflareaccess.com
CF_ACCESS_AUDIENCE=REPLACE_WITH_ACCESS_AUDIENCE
CF_ACCESS_JWKS_URL=https://REPLACE.cloudflareaccess.com/cdn-cgi/access/certs
# Bounded current-key cache in milliseconds (1000 through 3600000).
CF_ACCESS_JWKS_CACHE_TTL_MS=300000
ASTRO_MEMBERSHIP_BOOTSTRAP_PATH=/run/config/membership-bootstrap.json
# The phone remote listener is always read-only. This retained value is ignored
# by the split listeners and remains only for compatibility with earlier configs.
ASTRO_CLIENT_CONTEXT=phone
# Optional authorized-download origin bridge. Keep the signer profile disabled
# until a dedicated read-only R2 credential and shared secret are installed.
ASTRO_DOWNLOAD_GRANT_URL=http://download-grant:8791/internal/download-grants
ASTRO_DOWNLOAD_GRANT_SHARED_SECRET_PATH=/run/secrets/download-grant-shared-secret
# Tunnel credentials and all policy membership emails remain host-managed.
