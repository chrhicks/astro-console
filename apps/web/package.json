{
  "name": "@astro-console/web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "dev:inspect": "vite --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build && npm run check:dist",
    "check:dist": "node scripts/check-dist.mjs",
    "test": "tsx --test src/**/*.test.ts",
    "check": "npm run format:check && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@astro-console/v2-contracts": "0.0.1",
    "@vitejs/plugin-react": "4.4.1",
    "effect": "4.0.0-beta.103",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vite": "6.3.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.15.18",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "10.8.0",
    "prettier": "3.6.2",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.65.0"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "0.25.12",
    "@rollup/rollup-darwin-arm64": "4.62.4"
  }
}
