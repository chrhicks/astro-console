# Copy outside the repository as the one Compose interpolation source for the
# profile-gated authorized-download files and mounts. These are Compose
# interpolation values, not service environment variables; `env_file` cannot
# provide Compose volume sources.
ASTRO_ORIGIN_ENV_FILE=/ABSOLUTE/HOST/PATH/config.env
ASTRO_DOWNLOAD_GRANT_ENV_FILE=/ABSOLUTE/HOST/PATH/download-grant.env
ASTRO_PUBLISHER_ENV_FILE=/ABSOLUTE/HOST/PATH/publisher.env
ASTRO_DOWNLOAD_GRANT_SHARED_SECRET_HOST_PATH=/ABSOLUTE/HOST/PATH/download-grant-shared-secret
R2_DOWNLOAD_CREDENTIALS_HOST_PATH=/ABSOLUTE/HOST/PATH/r2-download-credentials.json
# Compose validates every service before selecting profiles. Preserve valid
# host-managed bind values for currently inactive rig and publisher profiles.
ASTRO_SEESTAR_PEM_HOST_PATH=/ABSOLUTE/HOST/PATH/seestar.pem
ASTRO_PUBLISHER_OUTPUTS_HOST_PATH=/ABSOLUTE/HOST/PATH/promoted-outputs
R2_CREDENTIALS_HOST_PATH=/ABSOLUTE/HOST/PATH/r2-publisher-credentials.json
