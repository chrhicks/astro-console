{
  "name": "seestar-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop app for the Seestar SDK",
  "main": "dist/main/index.js",
  "scripts": {
    "build:sdk": "npm --prefix ../../sdk run build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:sdk && npm run build:main && npm run build:renderer",
    "dev:sdk": "npm --prefix ../../sdk run dev",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 file:dist/main/index.js file:../../sdk/dist/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist/main/index.js",
    "dev": "npm run build:sdk && concurrently -k \"npm:dev:sdk\" \"npm:dev:main\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "start": "npm run build && electron dist/main/index.js"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "electron": "^35.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
