{
  "name": "astro-console",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "effect": "4.0.0-beta.103"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "0.28.1"
  },
  "workspaces": [
    "apps/server",
    "apps/web",
    "packages/v2-contracts"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "check": "npm run check --workspaces",
    "test": "npm run test --workspaces",
    "setup": "npm run build --workspace @astro-console/v2-contracts",
    "dev:inspect": "npm run setup && npm run dev:inspect --workspace @astro-console/server --"
  }
}
