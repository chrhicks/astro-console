{
  "name": "seestar-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for ZWO Seestar S30",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "prettier --write .",
    "run": "node dist/index.js",
    "solar:process": "node dist/cli/solar-process.js",
    "dev:smoke": "node dist/cli/dev-smoke.js",
    "probe:api": "node dist/cli/api-probe.js",
    "extract:album": "node dist/cli/extract-album.js",
    "watch:stack": "node dist/cli/stack-watch.js",
    "fetch:latest-subframe": "node dist/cli/fetch-latest-subframe.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "effect": "^3.21.3"
  }
}
