{
  "name": "seestar-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for ZWO Seestar S30",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "prettier --write .",
    "run": "node dist/index.js",
    "solar:process": "node dist/cli/solar-process.js",
    "dev:smoke": "node dist/cli/dev-smoke.js",
    "baseline:reset": "node dist/cli/baseline-reset.js",
    "slew:check": "node dist/cli/slew-check.js",
    "probe:api": "node dist/cli/api-probe.js",
    "map:horizon": "node dist/cli/map-horizon.js",
    "extract:album": "node dist/cli/extract-album.js",
    "watch:stack": "node dist/cli/stack-watch.js",
    "fetch:latest-subframe": "node dist/cli/fetch-latest-subframe.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "effect": "4.0.0-beta.98"
  }
}
