{
  "name": "@astro-console/v2-contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run typecheck && tsc --project tsconfig.build.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "npm run format:check && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "effect": "4.0.0-beta.103"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.18",
    "eslint": "^10.8.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0"
  }
}
